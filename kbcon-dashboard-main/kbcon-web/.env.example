# ==============================================================================
# KBCON Dashboard Local Development Environment (.env.example)
# Copy this file to .env.local for local testing with Firebase Emulators.
# ==============================================================================

# Client Firebase Configuration (Targets local emulators when NEXT_PUBLIC_USE_EMULATOR=true)
NEXT_PUBLIC_FIREBASE_API_KEY="local-dev-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="kbcon-dashboard.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="kbcon-dashboard"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="kbcon-dashboard.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# Hook to connect Firebase Client SDK to local emulators
NEXT_PUBLIC_USE_EMULATOR="true"

# Server-Side Next.js BFF Settings (DO NOT PREFIX WITH NEXT_PUBLIC_)
# Never expose DH360_OPERATOR_TOKEN to browser JavaScript!
DH360_API_URL="http://127.0.0.1:8001"
DH360_OPERATOR_TOKEN="dh360-local-operator-secret-2026"

# Local Firebase Emulator Hosts for Server-Side Token Validation
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
