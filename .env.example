# Digital Health 360 - Human Interaction Environment Configuration
# Copy this file or export these variables in your shell. Never commit real secrets.

# ==============================================================================
# Operator Authentication & API Security (M3.2.1 / M3.2.2)
# ==============================================================================
# Generate a secure token with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
DH360_HI_API__OPERATOR_TOKEN=your-secure-operator-token-here

# Required scopes for the Demo UI and Operator Administration:
# persons:read, persons:create, persons:update, persons:delete,
# biometrics:reset, consent:manage, enrollment:manage, interaction:read, authorization:manage
DH360_HI_API__OPERATOR_SCOPES=persons:read,persons:create,persons:update,persons:delete,biometrics:reset,consent:manage,enrollment:manage,interaction:read,authorization:manage

# ==============================================================================
# Storage & Database
# ==============================================================================
DH360_HI_DB_PATH=dh360_hi.db

# ==============================================================================
# Eliva Third-Party Speech & AI Integrations (Optional / Live Mode)
# ==============================================================================
# Gemini LLM API Key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Soniox Speech-to-Text API Key
SONIOX_API_KEY=your_soniox_api_key_here

# Google Cloud Text-to-Speech Credentials:
# Specify the absolute path to a service account JSON file, OR provide raw JSON string
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ==============================================================================
# Edge Vision & Camera Hardware (Raspberry Pi / Local)
# ==============================================================================
# USB UVC camera index (e.g., 0 for /dev/video0, 2 for /dev/video2)
DH360_HI_CAMERA_INDEX=0

# Pacing frame rate ceiling for edge runtime
DH360_HI_RUNTIME__TARGET_FPS=30.0

# Optional explicit model weights paths (defaults to models/weights/ if downloaded)
# DH360_HI_DETECTOR_MODEL_PATH=models/weights/face_detection_yunet_2023mar.onnx
# DH360_HI_EMBEDDER_MODEL_PATH=models/weights/face_recognition_sface_2021dec.onnx
