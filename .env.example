# Digital Health 360 - Human Interaction Environment Configuration
# Copy this file to .env for local configuration. Never commit .env with real secrets.

# Environment Mode: development | testing | production
DH360_ENV=development
DH360_LOG_LEVEL=INFO

# Edge Vision Service Configuration
DH360_CAMERA_INDEX=0
DH360_VISION_TARGET_FPS=15
DH360_EDGE_HOST=127.0.0.1
DH360_EDGE_PORT=8001

# Backend Service Configuration
DH360_BACKEND_HOST=127.0.0.1
DH360_BACKEND_PORT=8000

# LLM Provider Configuration (Do not commit real keys)
# LLM_API_KEY=
# LLM_MODEL_NAME=gpt-4o-mini
